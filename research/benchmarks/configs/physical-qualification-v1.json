{
  "schemaVersion": "packproof.benchmark-policy.v1",
  "version": "physical-qualification-v1",
  "freezeBeforeTestSetAccess": true,
  "confidence": 0.95,
  "errorTargets": {"F01": 0.0001, "F04": 0.01, "F06": 0.01},
  "holdoutDimensions": ["physicalInstanceId", "captureSessionId", "sourceDigest", "printRunId", "cartonId", "labelId", "deviceId", "materialLot", "printerUnitId", "attackDeviceId"],
  "F01": {
    "screeningPopulationLabels": 240,
