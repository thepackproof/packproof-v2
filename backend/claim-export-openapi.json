  "components": {
    "securitySchemes": {
      "humanBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "First-party authenticated human session; service credentials are refused."
      }
    },
    "schemas": {
      "ClaimCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "integrationAccountId": {
            "type": "string"
          },
          "disputeId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "orderLineIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "Existing transaction item IDs in this Proof. Empty means payment-only scope; no line allocation is implied."
          },
          "reasonCode": {
            "type": "string",
            "maxLength": 80
          },
          "network": {
            "enum": [
              "MASTERCARD",
              "VISA",
              "AMEX",
              "DISCOVER",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "lifecycleStatus": {
            "enum": [
              "needs_response",
              "warning_needs_response",
              "under_review",
              "warning_under_review",
              "won",
              "lost",
              "warning_closed",
              "prevented"
            ]
          },
          "providerDeadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "allowedActions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "enum": [
                "RESPOND",
                "ACCEPT"
              ]
            }
          },
          "region": {
            "const": "US"
          },
          "paymentMethod": {
            "const": "CARD"
          }
        },
        "required": [
          "integrationAccountId",
          "disputeId",
          "paymentId",
          "orderLineIds",
          "reasonCode",
          "network",
          "lifecycleStatus",
          "providerDeadline",
          "retrievedAt",
          "allowedActions",
          "region",
          "paymentMethod"
        ]
      },
      "ClaimRevision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedSnapshotSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reasonCode": {
            "type": "string",
            "maxLength": 80
          },
          "network": {
            "enum": [
              "MASTERCARD",
              "VISA",
              "AMEX",
              "DISCOVER",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "lifecycleStatus": {
            "enum": [
              "needs_response",
              "warning_needs_response",
              "under_review",
              "warning_under_review",
              "won",
              "lost",
              "warning_closed",
              "prevented"
            ]
          },
          "providerDeadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "allowedActions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "enum": [
                "RESPOND",
                "ACCEPT"
              ]
            }
          },
          "region": {
            "const": "US"
          },
          "paymentMethod": {
            "const": "CARD"
          }
        },
        "required": [
          "expectedSnapshotSha256",
          "reasonCode",
          "network",
          "lifecycleStatus",
          "providerDeadline",
          "retrievedAt",
          "allowedActions",
          "region",
          "paymentMethod"
        ]
      },
      "ClaimSnapshot": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "packproof.claim-case/v1"
          },
          "claimCaseId": {
            "type": "string"
          },
          "proofId": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "environment": {
            "enum": [
              "sandbox",
              "live"
            ]
          },
          "integrationAccountId": {
            "type": "string"
          },
          "provider": {
            "const": "stripe"
          },
          "providerAccountId": {
            "type": "string"
          },
          "disputeId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "orderLineIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasonCode": {
            "type": "string",
            "maxLength": 80
          },
          "network": {
            "enum": [
              "MASTERCARD",
              "VISA",
              "AMEX",
              "DISCOVER",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "lifecycleStatus": {
            "enum": [
              "needs_response",
              "warning_needs_response",
              "under_review",
              "warning_under_review",
              "won",
              "lost",
              "warning_closed",
              "prevented"
            ]
          },
          "providerDeadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "allowedActions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "enum": [
                "RESPOND",
                "ACCEPT"
              ]
            }
          },
          "source": {
            "const": "MERCHANT_REPORTED"
          },
          "providerVerification": {
            "const": "UNVERIFIED"
          },
          "apiVersion": {
            "const": "MANUAL_PORTAL"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "previousSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedBy": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "region": {
            "const": "US"
          },
          "paymentMethod": {
            "const": "CARD"
          }
        }
      },
      "ClaimView": {
        "type": "object",
        "required": [
          "claimCaseId",
          "revisionId",
          "revision",
          "snapshotSha256",
          "snapshot",
          "preservation",
          "providerSubmission"
        ],
        "properties": {
          "claimCaseId": {
            "type": "string"
          },
          "revisionId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "snapshotSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ClaimSnapshot"
          },
          "preservation": {
            "type": "object",
            "description": "PRESERVED only after the independent recovery outbox has issued a durable receipt."
          },
          "providerSubmission": {
            "const": "UNAVAILABLE"
          }
        }
      },
      "ClaimList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cases": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ClaimView"
            }
          }
        },
        "required": [
          "cases"
        ]
      },
      "ClaimBoundExport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": {
            "type": "string",
            "description": "Existing scoped SignatureCase preview ID, distinct from the ClaimCase business identity."
          },
          "claimCaseId": {
            "type": "string"
          },
          "claimSnapshotSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "profileId": {
            "enum": [
              "stripe-dispute-us-mastercard-v2",
              "stripe-dispute-us-other-v2"
            ]
          },
          "destinationInstructionsReviewed": {
            "const": true
          },
          "destinationDeadline": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "narrative": {
            "type": "string",
            "maxLength": 2000
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidenceId": {
                  "type": "string"
                },
                "offsetMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 21600000
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "evidenceId",
                "offsetMs",
                "label"
              ]
            }
          }
        },
        "required": [
          "caseId",
          "claimCaseId",
          "claimSnapshotSha256",
          "profileId",
          "destinationInstructionsReviewed",
          "destinationDeadline",
          "narrative",
          "frames"
        ]
      },
      "ClaimExportApproval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claimSnapshotSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "action": {
            "const": "EXPORT_FOR_MERCHANT_REVIEW"
          },
          "legibilityConfirmed": {
            "const": true
          }
        },
        "required": [
          "artifactSha256",
          "claimSnapshotSha256",
          "action",
          "legibilityConfirmed"
        ]
      },
      "ExportView": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "proofId": {
            "type": "string"
          },
          "caseId": {
            "type": "string"
          },
          "claimCaseId": {
            "type": "string"
          },
          "claimSnapshotSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "action": {
            "const": "EXPORT_FOR_MERCHANT_REVIEW"
          },
          "providerSubmission": {
            "const": "UNAVAILABLE"
          },
          "state": {
            "enum": [
              "QUEUED",
              "RENDERING",
              "READY",
              "FAILED"
            ]
          },
          "claimReview": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "PREPARING",
                  "REVIEW_REQUIRED",
                  "APPROVED",
                  "FAILED"
                ]
              },
              "requiresNewApproval": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "artifact": {
            "type": [
              "object",
              "null"
            ],
            "description": "Frozen exact case revision, versioned reason/network profile, scope, source hashes/actors/offsets, gaps and output hashes. Historical approval remains inspectable after the case changes."
          }
        }
      }
    }
  }
}
