  "components": {
    "securitySchemes": {
      "humanBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing first-party user identity; service principals cannot enqueue signing."
      },
      "partnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Current partner credential with exports:read, merchant binding and applicable delegation."
      }
    },
    "schemas": {
      "EnvelopeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordType",
          "recordId"
        ],
        "properties": {
          "recordType": {
            "type": "string",
            "enum": [
              "CORE",
              "STAGE",
              "SUPPLEMENT"
            ]
          },
          "recordId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          }
        }
      },
      "EnvelopeStatus": {
        "type": "object",
        "required": [
          "operationId",
          "proofId",
          "recordType",
          "recordId",
          "manifestSha256",
          "state"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proofId": {
            "type": "string"
          },
          "recordType": {
            "type": "string",
            "enum": [
              "CORE",
              "STAGE",
              "SUPPLEMENT"
            ]
          },
          "recordId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "SIGNED_PENDING_DURABILITY",
              "READY",
              "FAILED"
            ]
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "EnvelopeAdmission": {
        "type": "object",
        "required": [
          "operationId",
          "proofId",
          "recordType",
          "recordId",
          "state",
          "replayed"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proofId": {
            "type": "string"
          },
          "recordType": {
            "type": "string",
            "enum": [
              "CORE",
              "STAGE",
              "SUPPLEMENT"
            ]
          },
          "recordId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "SIGNED_PENDING_DURABILITY",
              "READY",
              "FAILED"
            ]
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
