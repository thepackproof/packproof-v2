{
  "name": "@packproof/v2-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:integrations": "tsx src/operations/check-integrations-cli.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "admin:bootstrap": "tsx src/admin/bootstrap-cli.ts",
    "admin:bootstrap:prod": "node dist/admin/bootstrap-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1120.0",
    "@aws-sdk/client-cost-explorer": "3.1120.0",
    "@aws-sdk/client-kms": "3.1120.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-secrets-manager": "^3.864.0",
    "@aws-sdk/client-sqs": "3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@electric-sql/pglite": "^0.3.7",
    "asn1js": "3.0.10",
    "aws-jwt-verify": "^5.2.1",
    "canonicalize": "5.1.0",
    "cbor": "10.0.11",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "parse5": "8.0.1",
    "pg": "^8.16.3",
    "pkijs": "3.4.1",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "qs@<6.16.0": "6.16.0",
    "body-parser": "1.20.9"
  }
}
