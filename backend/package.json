{
  "name": "@packproof/v2-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-secrets-manager": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "aws-jwt-verify": "^5.2.1",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@types/express": "^4.17.23",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
