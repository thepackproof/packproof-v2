PORT=3000
PACKPROOF_PUBLIC_URL=http://127.0.0.1:3000
PACKPROOF_DEV_AUTH=true
PACKPROOF_UPLOAD_SECRET=dev-upload-secret

# PostgreSQL. If unset, local PGlite is used under ./data
# DATABASE_URL=postgres://packproof:packproof@127.0.0.1:5432/packproof_v2

# Object store. Explicit only: local (default) or s3. Local development does not need AWS.
PACKPROOF_OBJECT_STORAGE=local
# OBJECT_STORE=local

# Required only when PACKPROOF_OBJECT_STORAGE=s3. Do not commit secrets.
# PACKPROOF_S3_BUCKET=packproof-v2-evidence
# AWS_S3_BUCKET=packproof-v2-evidence
# AWS_REGION=us-east-1
# PACKPROOF_S3_UPLOAD_EXPIRES_SECONDS=3600
# Runtime credentials: default AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# AWS_PROFILE, or instance/task IAM role). Never embed keys in the mobile client.
# Opt-in live S3 test only: PACKPROOF_S3_INTEGRATION=1
