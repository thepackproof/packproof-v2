PORT=3000
PACKPROOF_PUBLIC_URL=http://127.0.0.1:3000
PACKPROOF_AUTH_MODE=dev
PACKPROOF_DEV_AUTH=true
PACKPROOF_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PACKPROOF_UPLOAD_SECRET=dev-upload-secret

# Required only when PACKPROOF_AUTH_MODE=cognito. Cognito is an auth adapter only.
# PACKPROOF_COGNITO_USER_POOL_ID=us-east-1_example
# PACKPROOF_COGNITO_CLIENT_ID=exampleClientId
# PACKPROOF_COGNITO_REGION=us-east-1
# Opt-in live Cognito test only: PACKPROOF_COGNITO_INTEGRATION=1

# PostgreSQL. If unset, local PGlite is used under ./data
# DATABASE_URL=postgres://packproof:packproof@127.0.0.1:5432/packproof_v2
# Optional RDS injection when DATABASE_URL is unset. Do not commit real values.
# PACKPROOF_DB_HOST=
# PACKPROOF_DB_USER=
# PACKPROOF_DB_PASSWORD=
# PACKPROOF_DB_NAME=packproof_v2
# PACKPROOF_DB_PORT=5432
# PACKPROOF_DB_SSLMODE=require

# Object store. Explicit only: local (default) or s3. Local development does not need AWS.
PACKPROOF_OBJECT_STORAGE=local
# OBJECT_STORE=local

# Required only when PACKPROOF_OBJECT_STORAGE=s3. Do not commit secrets.
# PACKPROOF_S3_BUCKET=packproof-v2-evidence
# AWS_S3_BUCKET=packproof-v2-evidence
# AWS_REGION=us-east-1
# PACKPROOF_S3_UPLOAD_EXPIRES_SECONDS=3600
# Runtime credentials: default AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# AWS_PROFILE, or instance/task IAM role). Never embed keys in the mobile client.
# Opt-in live S3 test only: PACKPROOF_S3_INTEGRATION=1
# Opt-in live staging health/auth checks only: PACKPROOF_STAGING_INTEGRATION=1
# PACKPROOF_STAGING_URL=https://pa-5faf90eb81cb4764b37bd3dc259a5ac4.ecs.us-east-1.on.aws
# After deploy-web.ps1, PACKPROOF_WEB_ORIGINS on the API is the CloudFront origin.

# Credential store for trusted integrations. Default env. Domain code never reads secrets directly.
# PACKPROOF_CREDENTIAL_STORE=env
# env:VAR_NAME credential references read that process environment variable as JSON { "apiKey", "webhookSecret", "mode" } or a bare key.
# PACKPROOF_CREDENTIAL_STORE=secrets-manager requires AWS_REGION and an ECS *task role* (not the execution role) with
# secretsmanager:GetSecretValue, CreateSecret, PutSecretValue, and DeleteSecret on
# arn:aws:secretsmanager:REGION:ACCOUNT:secret:packproof/*/integrations/*
# Opt-in live EasyPost TEST MODE only. Never required for npm test. Do not commit a real key.
# PACKPROOF_EASYPOST_INTEGRATION=1
# PACKPROOF_EASYPOST_TEST_API_KEY=

# eBay marketplace (disabled until PACKPROOF_EBAY_INTEGRATION_ENABLED=true).
# The Cert ID is the OAuth client secret. Never put it in Vite, Expo, or Git.
# PACKPROOF_EBAY_INTEGRATION_ENABLED=true
# PACKPROOF_EBAY_ENVIRONMENT=sandbox
# PACKPROOF_EBAY_CLIENT_ID=
# PACKPROOF_EBAY_CLIENT_SECRET=
# PACKPROOF_EBAY_DEV_ID=
# PACKPROOF_EBAY_RUNAME=
# PACKPROOF_EBAY_MARKETPLACE_ID=EBAY_US
# PACKPROOF_EBAY_DELETION_VERIFICATION_TOKEN=
# Aliases EBAY_* are accepted. Production keysets also require the Marketplace
# Account Deletion endpoint or an eBay Developer Portal exemption. See docs/EBAY_INTEGRATION.md.

# Connected accounts (disabled until each PACKPROOF_*_INTEGRATION_ENABLED=true).
# Secrets stay on the API. Never put these in Vite, Expo, or Git.
# See docs/CONNECTED_ACCOUNTS.md for redirect URLs and capabilities.
# PACKPROOF_SHOPIFY_INTEGRATION_ENABLED=true
# PACKPROOF_SHOPIFY_CLIENT_ID=
# Etsy: request shops_r + transactions_r only. Enable after Etsy app approval.
# PACKPROOF_ETSY_INTEGRATION_ENABLED=false
# PACKPROOF_ETSY_CLIENT_ID=
# PACKPROOF_ETSY_APP_CREDENTIAL_REFERENCE=packproof/staging/integrations/etsy/app
# Store {"sharedSecret":"..."} in the managed secret, never in source or client builds.
# PACKPROOF_ETSY_SHARED_SECRET=  # Local development only; managed store required when hosted.
# Optional exact HTTPS URL registered in Etsy; otherwise PUBLIC_URL + /oauth/etsy/callback.
# PACKPROOF_ETSY_REDIRECT_URI=https://thepackproof.com/api/oauth/etsy/callback
# PACKPROOF_SHOPIFY_CLIENT_SECRET=
# PACKPROOF_GOOGLE_INTEGRATION_ENABLED=true
# PACKPROOF_GOOGLE_CLIENT_ID=
# PACKPROOF_GOOGLE_CLIENT_SECRET=
# PACKPROOF_FACEBOOK_INTEGRATION_ENABLED=true
# PACKPROOF_FACEBOOK_APP_ID=
# PACKPROOF_FACEBOOK_APP_SECRET=
# Aliases: PACKPROOF_META_* for Facebook, SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET.


# Signed partner webhooks: disabled until a 32-byte base64 master key and exact
# permitted DNS hostnames are supplied. Store the key in Secrets Manager in ECS.
# PACKPROOF_WEBHOOK_ENCRYPTION_KEY=
# Also required for encrypted partner API viewing-link replay responses,
# even when outbound webhook dispatch is disabled. Keep stable across releases.
# PACKPROOF_WEBHOOK_HOSTS=hooks.your-company.example
# PACKPROOF_WEBHOOK_WORKER=true

# Portable manifest signing: explicitly unsigned until operator-provisioned keys exist.
# Never paste private PEM contents into environment variables, Git, logs or client bundles.
PACKPROOF_MANIFEST_SIGNING_MODE=unsigned
PACKPROOF_MANIFEST_SIGNING_REQUIRED=false
# To require signed finalization: mode=pem and required=true, plus all four settings below.
# PACKPROOF_MANIFEST_SIGNING_KEY_FILE=/run/secrets/packproof/manifest-key.pem
# PACKPROOF_MANIFEST_SIGNING_KEY_ID=packproof-signing-2026-01
# PACKPROOF_MANIFEST_SIGNING_ALGORITHM=ECDSA_SHA_256
# PACKPROOF_MANIFEST_TRUST_LIST_FILE=/run/config/packproof/trust-list.json
# Private file: owned by API user, 0400/0600. Public trust list: independently published.
# Runtime rejects missing/mismatched/revoked/expired key configuration; no signing fallback.
# See docs/MANIFEST_SIGNING_OPERATIONS.md.

# AWS KMS alternative (no PEM mount): use mode=kms, required=true and an existing exact ARN.
# PACKPROOF_MANIFEST_KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT:key/EXISTING-KEY-UUID
# PACKPROOF_MANIFEST_SIGNING_KEY_ID=packproof-signing-2026-01
# PACKPROOF_MANIFEST_SIGNING_ALGORITHM=ECDSA_SHA_256
# PACKPROOF_MANIFEST_TRUST_TTL_SECONDS=604800
# PACKPROOF_MANIFEST_TRUST_HISTORY_JSON=[]
# API task role: kms:Sign and kms:GetPublicKey on that exact key ARN only.
# Shippo tracking (server only). Test keys accept SHIPPO_* simulator numbers only.
# PACKPROOF_CAPTURE_SHIPPO_CREDENTIAL_REFERENCE=env:PACKPROOF_SHIPPO_CREDENTIALS
# PACKPROOF_SHIPPO_CREDENTIALS={"apiKey":"shippo_test_REPLACE","mode":"test"}
# Live: use a Secrets Manager reference and shippo_live_ key, mode production.
# Polling works without webhooks. Add webhookSecret and registerWebhooks="true"
# only after Shippo has enabled HMAC and the signed endpoint is configured.
# Order intake pilot: keep inactive until real source and device acceptance pass.
PACKPROOF_INTAKE_ENABLED=false
PACKPROOF_INTAKE_ACTOR_IDS=
PACKPROOF_INTAKE_HANDOFF=false
PACKPROOF_INTAKE_BROWSER=false
PACKPROOF_INTAKE_EMAIL=false
PACKPROOF_INTAKE_SHIPPO=false
PACKPROOF_INTAKE_MAIL_DOMAIN=
PACKPROOF_INTAKE_RAW_BUCKET=
PACKPROOF_INTAKE_RAW_PREFIX=received/
PACKPROOF_INTAKE_TOPIC_ARN=
PACKPROOF_INTAKE_QUEUE_URL=
