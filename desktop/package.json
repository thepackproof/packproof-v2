{
  "name": "@packproof/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "PackProof fulfillment evidence workstation",
  "author": "PackProof",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:win": "npm run package -- --win nsis --x64",
    "package:mac": "npm run package -- --mac",
    "check": "npm run typecheck && npm test",
    "test:release": "node --test tests/release-policy.test.cjs tests/release-distribution.test.cjs",
    "verify:artifacts": "node scripts/verify-artifacts.cjs"
  },
  "dependencies": {
    "@sentry/node": "11.0.0",
    "electron-updater": "6.8.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.13",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "yaml": "2.9.1"
  }
}
