{
  "name": "@packproof/v2-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:android:internal": "npx --yes eas-cli@24.4.2 build --platform android --profile internal-staging --non-interactive",
    "test:api": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/native-api-contract.test.ts tests/commerce-connections.test.ts",
    "test:camera-spike": "node --experimental-strip-types --test tests/camera-spike-model.test.ts",
    "test:proof-record": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/proof-record.test.ts tests/proof-tracking.test.ts tests/scroll-restoration.test.ts",
    "test:recovery": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/capture-recovery.test.ts",
    "test:identifiers": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/identifier-capture.test.ts",
    "postinstall": "node scripts/secure-build-dependencies.cjs",
    "eas-build-on-success": "node scripts/verify-eas-android-release.cjs",
    "test:build-security": "node --test tests/build-dependency-security.test.cjs tests/release-identity.test.cjs",
    "test:study-timing": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/study-timing.test.ts tests/native-study-timing.test.ts",
    "android:go": "expo start --android",
    "ios:go": "expo start --ios",
    "test:redesign": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/sales-channels.test.ts tests/capture-label-review.test.ts tests/orders.test.ts",
    "test:intake": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/intake-context.test.ts tests/intake-resolution.test.ts tests/intake-delivery.test.ts",
    "build:ios:simulator": "npx --yes eas-cli@24.4.2 build --platform ios --profile ios-simulator --non-interactive",
    "build:ios:device": "npx --yes eas-cli@24.4.2 build --platform ios --profile ios-device",
    "build:ios:testflight": "npx --yes eas-cli@24.4.2 build --platform ios --profile ios-testflight",
    "submit:ios:testflight": "npx --yes eas-cli@24.4.2 submit --platform ios --profile ios-testflight",
    "test:ios-config": "node --test tests/ios-release-config.test.cjs",
    "test:ios": "node --test tests/ios-release-config.test.cjs tests/order-share-plugin.test.cjs && node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/ios-parity.test.ts tests/ios-billing.test.ts tests/handoff-sender.test.ts tests/developer-access.test.ts tests/supporting-tools.test.ts tests/statements.test.ts tests/redactions.test.ts tests/relay-station.test.ts tests/signature-workflows.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "base64-js": "^1.5.1",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-navigation-bar": "~4.2.8",
    "expo-notifications": "~0.31.5",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-video": "~2.2.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "image-size": "npm:image-size-next@1.2.2",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "@expo/metro-config": {
      "postcss": "8.5.28"
    },
    "@expo/bunyan": {
      "uuid": "11.1.1"
    },
    "@expo/rudder-sdk-node": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "tar": "7.5.22",
    "image-size": "npm:image-size-next@1.2.2"
  }
}
