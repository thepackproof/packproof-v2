{
  "name": "@packproof/v2-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:android:internal": "npx --yes eas-cli build --platform android --profile internal-staging --non-interactive",
    "test:api": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/native-api-contract.test.ts tests/commerce-connections.test.ts",
    "test:camera-spike": "node --experimental-strip-types --test tests/camera-spike-model.test.ts",
    "test:proof-record": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/proof-record.test.ts tests/proof-tracking.test.ts tests/scroll-restoration.test.ts",
    "test:recovery": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/capture-recovery.test.ts",
    "test:identifiers": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/identifier-capture.test.ts",
    "postinstall": "node scripts/secure-build-dependencies.cjs",
    "test:build-security": "node --test tests/build-dependency-security.test.cjs tests/release-identity.test.cjs",
    "test:study-timing": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/study-timing.test.ts tests/native-study-timing.test.ts",
    "android:go": "expo start --android",
    "ios:go": "expo start --ios",
    "test:redesign": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/sales-channels.test.ts tests/capture-label-review.test.ts tests/orders.test.ts",
    "test:intake": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/intake-context.test.ts tests/intake-resolution.test.ts",
    "build:ios:simulator": "npx --yes eas-cli build --platform ios --profile ios-simulator --non-interactive",
    "build:ios:device": "npx --yes eas-cli build --platform ios --profile ios-device",
    "build:ios:testflight": "npx --yes eas-cli build --platform ios --profile ios-testflight",
    "submit:ios:testflight": "npx --yes eas-cli submit --platform ios --profile ios-testflight",
    "test:ios-config": "node --test tests/ios-release-config.test.cjs",
    "test:ios": "node --test tests/ios-release-config.test.cjs tests/order-share-plugin.test.cjs && node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/ios-parity.test.ts tests/ios-billing.test.ts tests/handoff-sender.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "base64-js": "^1.5.1",
    "expo": "~52.0.47",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-navigation-bar": "~4.0.9",
    "expo-notifications": "^0.29.14",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-video": "~2.0.6",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "image-size": "npm:image-size-next@1.2.2",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "@expo/metro-config": {
      "postcss": "8.5.28"
    },
    "@expo/bunyan": {
      "uuid": "11.1.1"
    },
    "@expo/rudder-sdk-node": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "tar": "7.5.22",
    "image-size": "npm:image-size-next@1.2.2"
  }
}
