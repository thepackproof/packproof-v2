{
  "name": "@packproof/braces-depth-guard",
  "description": "PackProof-maintained security patch of braces@3.0.3; see PATCHES.md",
  "version": "3.0.3-packproof.1",
  "homepage": "https://github.com/micromatch/braces",
  "author": "Jon Schlinkert (https://github.com/jonschlinkert)",
  "contributors": [
    "Brian Woodward (https://twitter.com/doowb)",
