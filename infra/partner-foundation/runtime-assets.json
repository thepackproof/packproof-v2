{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private synthetic M1 API/worker acceptance assets; never targets production.",
  "Parameters": {
    "EgressAvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Default": "us-east-1a",
      "AllowedValues": [
        "us-east-1a"
      ],
      "Description": "Same availability zone as the approved first private subnet"
    },
    "CandidateCommit": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}",
      "Description": "Exact reviewed PR commit to execute"
    },
    "WriterFence": {
      "Type": "String",
      "Default": "OPEN",
      "AllowedValues": [
        "OPEN",
        "CLOSED"
      ],
      "Description": "CLOSED denies source API and worker storage writes and signing, including existing STS sessions."
    },
    "ComputeEnabled": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Pause only after service DesiredCount is zero and the database is closed; removes temporary build and egress resources."
    }
  },
  "Conditions": {
    "WritersFenced": {
      "Fn::Equals": [
        {
          "Ref": "WriterFence"
        },
        "CLOSED"
      ]
    },
    "ComputeActive": {
      "Fn::Equals": [
        {
          "Ref": "ComputeEnabled"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "BuildSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "GroupDescription": "One-shot recovery acceptance runner: HTTPS downloads and isolated PostgreSQL only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Public GitHub, npm, AWS APIs and RDS CA distribution over TLS"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": "sg-000d9cd26399d10d2",
            "Description": "Isolated test database only"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 3443,
            "ToPort": 3443,
            "DestinationSecurityGroupId": {
              "Ref": "ServiceSecurityGroup"
            }
          }
        ]
      },
      "Condition": "ComputeActive"
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-000d9cd26399d10d2",
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "BuildSecurityGroup"
        },
        "Description": "Temporary isolated recovery acceptance runner"
      },
      "Condition": "ComputeActive"
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Condition": "ComputeActive"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "Condition": "ComputeActive"
    },
    "EgressSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "CidrBlock": "10.42.20.0/24",
        "AvailabilityZone": {
          "Ref": "EgressAvailabilityZone"
        },
        "MapPublicIpOnLaunch": false
      },
      "Condition": "ComputeActive"
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3"
      },
      "Condition": "ComputeActive"
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "Condition": "ComputeActive"
    },
    "PublicAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "EgressSubnet"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      },
      "Condition": "ComputeActive"
    },
    "NatAddress": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc"
      },
      "Condition": "ComputeActive"
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatAddress",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "EgressSubnet"
        }
      },
      "Condition": "ComputeActive"
    },
    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3"
      },
      "Condition": "ComputeActive"
    },
    "PrivateRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      },
      "Condition": "ComputeActive"
    },
    "PrivateAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": "subnet-00ce0618188c68de8",
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      },
      "Condition": "ComputeActive"
    },
    "PrivateAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": "subnet-0be41abd945430b4d",
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      },
      "Condition": "ComputeActive"
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/packproof/packproof-m1-20261021-runtime",
        "RetentionInDays": 30
      }
    },
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "packproof-m1-20261021-runtime",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "EmptyOnDelete": false
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "packproof-m1-20261021-runtime",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "ApiDatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "packproof-m1-20261021-runtime/ApiDatabase",
        "Description": "Synthetic private acceptance only; populated by bootstrap without logging values"
      }
    },
    "WorkerDatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "packproof-m1-20261021-runtime/WorkerDatabase",
        "Description": "Synthetic private acceptance only; populated by bootstrap without logging values"
      }
    },
    "ConfigurationSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "packproof-m1-20261021-runtime/Configuration",
        "Description": "Synthetic private acceptance only; populated by bootstrap without logging values"
      }
    },
    "TlsSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "packproof-m1-20261021-runtime/Tls",
        "Description": "Synthetic private acceptance only; populated by bootstrap without logging values"
      }
    },
    "ServiceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "GroupDescription": "Private API and worker; no public ingress",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": "sg-000d9cd26399d10d2"
          }
        ]
      }
    },
    "ServiceDatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-000d9cd26399d10d2",
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "ServiceSecurityGroup"
        }
      }
    },
    "ApiTlsIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ServiceSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3443,
        "ToPort": 3443,
        "SourceSecurityGroupId": {
          "Ref": "BuildSecurityGroup"
        }
      },
      "Condition": "ComputeActive"
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "packproof-m1-20261021-runtime-api",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "784514617543"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ecs:us-east-1:784514617543:*"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "IsolatedRecoveryAcceptance",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DistinguishMissingMedia",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": [
                    "arn:aws:s3:::packproof-m1-20261020-uploadbucket-8o4ikwomdg8h",
                    "arn:aws:s3:::packproof-m1-20261020-committedbucket-trlqhna2z8s5"
                  ]
                },
                {
                  "Sid": "SyntheticMedia",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    "arn:aws:s3:::packproof-m1-20261020-uploadbucket-8o4ikwomdg8h/evidence/*",
                    "arn:aws:s3:::packproof-m1-20261020-committedbucket-trlqhna2z8s5/evidence/*"
                  ]
                },
                {
                  "Sid": "ManifestSigning",
                  "Effect": "Allow",
                  "Action": [
                    "kms:GetPublicKey",
                    "kms:Sign"
                  ],
                  "Resource": "arn:aws:kms:us-east-1:784514617543:key/6d65691f-a10c-4547-b806-896c3d660493"
                },
                {
                  "Sid": "NoRecoveryJournal",
                  "Effect": "Deny",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": "arn:aws:s3:::packproof-m1-20261020-recoverybucket-aripohrxorbp/*"
                },
                {
                  "Sid": "NoRecoverySigning",
                  "Effect": "Deny",
                  "Action": "kms:Sign",
                  "Resource": "arn:aws:kms:us-east-1:784514617543:key/1730036e-b64f-4137-8a1d-11964782b97d"
                },
                {
                  "Sid": "NoRetentionOrKeyAdministration",
                  "Effect": "Deny",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion",
                    "s3:BypassGovernanceRetention",
                    "s3:PutObjectRetention",
                    "s3:PutObjectLegalHold",
                    "kms:DisableKey",
                    "kms:ScheduleKeyDeletion",
                    "kms:PutKeyPolicy",
                    "kms:CreateGrant",
                    "secretsmanager:GetSecretValue",
                    "iam:*"
                  ],
                  "Resource": "*"
                },
                {
                  "Fn::If": [
                    "WritersFenced",
                    {
                      "Sid": "SourceWritersExternallyFenced",
                      "Effect": "Deny",
                      "Action": [
                        "s3:PutObject",
                        "kms:Sign"
                      ],
                      "Resource": [
                        "arn:aws:s3:::packproof-m1-20261020-uploadbucket-8o4ikwomdg8h/evidence/*",
                        "arn:aws:s3:::packproof-m1-20261020-committedbucket-trlqhna2z8s5/evidence/*",
                        "arn:aws:s3:::packproof-m1-20261020-recoverybucket-aripohrxorbp/*",
                        "arn:aws:kms:us-east-1:784514617543:key/6d65691f-a10c-4547-b806-896c3d660493",
                        "arn:aws:kms:us-east-1:784514617543:key/1730036e-b64f-4137-8a1d-11964782b97d"
                      ]
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Sid": "ReadTestConfiguration",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": "arn:aws:s3:::packproof-m1-20261020-uploadbucket-8o4ikwomdg8h/acceptance/runtime/config/*"
                },
                {
                  "Sid": "WriteRoleProbe",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": "arn:aws:s3:::packproof-m1-20261020-uploadbucket-8o4ikwomdg8h/acceptance/runtime/probes/api/*"
                }
              ]
            }
          }
        ]
      }
    },
    "ApiExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "packproof-m1-20261021-runtime-api-execution",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
