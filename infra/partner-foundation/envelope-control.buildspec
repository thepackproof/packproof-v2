{
  "version": 0.2,
  "phases": {
    "install": {
      "runtime-versions": {"nodejs": 22},
      "on-failure": "ABORT",
      "commands": [
        "test \"$PACKPROOF_TEST_PURPOSE\" = isolated-m2-synthetic",
        "git init candidate",
        "cd candidate",
        "git remote add origin https://github.com/thepackproof/packproof-v2.git",
        "git fetch --depth=1 origin \"$CANDIDATE_SHA\"",
        "git checkout --detach \"$CANDIDATE_SHA\"",
        "test \"$(git rev-parse HEAD)\" = \"$CANDIDATE_SHA\"",
        "cd backend",
        "npm ci --no-audit --no-fund",
        "if [ \"$M2_CONTROL\" = bootstrap ]; then apt-get update -qq && apt-get install -y -qq --no-install-recommends ffmpeg; fi",
        "curl --fail --silent --show-error --proto =https --tlsv1.2 -o /tmp/packproof-rds-ca.pem https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem"
      ]
    },
    "build": {
      "on-failure": "ABORT",
      "commands": ["node --import tsx scripts/isolated-envelope-control.mjs"]
    }
  },
  "artifacts": {"files": ["**/*"], "base-directory": "candidate/backend/runtime-artifacts"}
}
