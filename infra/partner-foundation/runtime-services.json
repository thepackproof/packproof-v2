                "Value": "s3"
              },
              {
                "Name": "PACKPROOF_S3_BUCKET",
                "Value": "packproof-m1-20261020-uploadbucket-8o4ikwomdg8h"
              },
              {
                "Name": "PACKPROOF_COMMITTED_S3_BUCKET",
                "Value": "packproof-m1-20261020-committedbucket-trlqhna2z8s5"
              },
              {
                "Name": "PACKPROOF_MANIFEST_SIGNING_MODE",
                "Value": "kms"
              },
              {
                "Name": "PACKPROOF_MANIFEST_SIGNING_REQUIRED",
