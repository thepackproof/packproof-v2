              },
              {
                "Name": "PACKPROOF_DB_NAME",
                "Value": "m1_service_20261021"
              },
              {
                "Name": "PACKPROOF_DB_USER",
                "Value": "m1_service_api"
              },
              {
                "Name": "PACKPROOF_DB_CA_FILE",
                "Value": "/app/backend/certs/rds-us-east-1-bundle.pem"
              },
              {
                "Name": "PACKPROOF_AUTH_MODE",
