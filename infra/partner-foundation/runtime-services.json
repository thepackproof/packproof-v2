            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": "us-east-1"
              },
              {
                "Name": "PACKPROOF_TEST_PURPOSE",
                "Value": "isolated-m1-synthetic"
              },
              {
                "Name": "PACKPROOF_ENVIRONMENT",
                "Value": "staging"
              },
              {
                "Name": "PACKPROOF_PROCESS_ROLE",
