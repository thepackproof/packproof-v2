{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private separate API and worker tasks; digest-pinned synthetic acceptance.",
  "Parameters": {
    "Image": {
      "Type": "String",
      "AllowedPattern": "784514617543.dkr.ecr.us-east-1.amazonaws.com/packproof-m1-20261021-runtime@sha256:[a-f0-9]{64}"
    },
    "CandidateCommit": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}",
      "Description": "Exact reviewed PR commit to execute"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "AllowedValues": [
        0,
        1
      ]
    },
    "ApiRole": {
      "Type": "String"
    },
    "WorkerRole": {
      "Type": "String"
    },
    "ApiExecutionRole": {
      "Type": "String"
    },
    "WorkerExecutionRole": {
      "Type": "String"
    },
    "ApiDatabaseSecret": {
      "Type": "String"
    },
    "WorkerDatabaseSecret": {
      "Type": "String"
    },
    "ConfigurationSecret": {
      "Type": "String"
    },
    "TlsSecret": {
      "Type": "String"
    },
    "ServiceSecurityGroup": {
      "Type": "String"
    },
    "Cluster": {
      "Type": "String"
    },
    "Logs": {
      "Type": "String"
    },
    "ProtectedRecovery": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ProtectionEvidence": {
      "Type": "String",
      "Default": "",
      "MaxLength": 4096,
      "Description": "Public reviewed evidence JSON from actual task-role and external-fence probes"
    },
    "ProtectionDigest": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|[a-f0-9]{64})"
    },
    "WriterGeneration": {
      "Type": "String",
      "Default": "initial",
      "AllowedPattern": "[a-zA-Z0-9-]{1,80}"
    }
  },
