        "Cpu": "256",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Ref": "ApiExecutionRole"
        },
        "TaskRoleArn": {
          "Ref": "ApiRole"
        },
        "Volumes": [
          {
            "Name": "temporary"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "User": "1000:1000",
            "MountPoints": [
              {
                "SourceVolume": "temporary",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "Command": [
              "node",
              "--input-type=module",
              "-e",
              "import fs from 'node:fs'; if(process.env.PACKPROOF_REQUIRE_DURABLE_RECEIPTS==='true')fs.writeFileSync('/tmp/recovery-protection.json',process.env.ISOLATED_PROTECTION_EVIDENCE); delete process.env.ISOLATED_PROTECTION_EVIDENCE; await import('./scripts/isolated-runtime-entrypoint.mjs');"
