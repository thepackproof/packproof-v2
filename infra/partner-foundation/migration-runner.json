{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Temporary migration runner and NAT egress for approved isolated M1 foundation. Synthetic data only. No production references.",
  "Parameters": {
    "CandidateCommit": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}",
      "Description": "Exact reviewed PR commit to execute"
    }
  },
  "Resources": {
    "BuildSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "GroupDescription": "One-shot migration runner: HTTPS downloads and isolated PostgreSQL only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Public GitHub, npm, AWS APIs and RDS CA distribution over TLS"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": "sg-000d9cd26399d10d2",
            "Description": "Isolated test database only"
          }
        ]
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-000d9cd26399d10d2",
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "BuildSecurityGroup"
        },
        "Description": "Temporary isolated migration runner"
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "EgressSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3",
        "CidrBlock": "10.42.20.0/24",
        "AvailabilityZone": "us-east-1a",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3"
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "EgressSubnet"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "NatAddress": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatAddress",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "EgressSubnet"
        }
      }
    },
    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": "vpc-0c4f12c0ba9393ae3"
      }
    },
    "PrivateRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "PrivateAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": "subnet-00ce0618188c68de8",
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "PrivateAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": "subnet-0be41abd945430b4d",
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "LogsKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Isolated M1 migration log encryption",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdministration",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::784514617543:root"
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "OnlyMigrationLogs",
              "Effect": "Allow",
              "Principal": {
                "Service": "logs.us-east-1.amazonaws.com"
              },
              "Action": [
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:DescribeKey"
              ],
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "kms:EncryptionContext:aws:logs:arn": "arn:aws:logs:us-east-1:784514617543:log-group:/packproof/packproof-m1-20261020/migration"
                }
              }
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/packproof/packproof-m1-20261020/migration",
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "LogsKey",
            "Arn"
          ]
        }
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "packproof-m1-20261020-migration-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "784514617543"
                },
                "ArnEquals": {
                  "aws:SourceArn": "arn:aws:codebuild:us-east-1:784514617543:project/packproof-m1-20261020-migration"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "IsolatedMigrationOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "BuildLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:us-east-1:784514617543:log-group:/packproof/packproof-m1-20261020/migration:*"
                },
                {
                  "Sid": "IsolatedDatabaseSecret",
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": "arn:aws:secretsmanager:us-east-1:784514617543:secret:rds!db-2e730349-8986-4ded-a190-20a2e369097b-6Ms46r"
                },
                {
                  "Sid": "DescribeNetwork",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeDhcpOptions",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeVpcs"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CreateRunnerNetworkInterface",
                  "Effect": "Allow",
                  "Action": "ec2:CreateNetworkInterface",
                  "Resource": [
                    "arn:aws:ec2:us-east-1:784514617543:network-interface/*",
                    "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-00ce0618188c68de8",
                    "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-0be41abd945430b4d",
                    {
                      "Fn::Sub": "arn:aws:ec2:us-east-1:784514617543:security-group/${BuildSecurityGroup}"
                    }
                  ]
                },
                {
                  "Sid": "DeleteRunnerNetworkInterface",
                  "Effect": "Allow",
                  "Action": "ec2:DeleteNetworkInterface",
                  "Resource": "arn:aws:ec2:us-east-1:784514617543:network-interface/*",
                  "Condition": {
                    "ArnEquals": {
                      "ec2:Subnet": [
                        "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-00ce0618188c68de8",
                        "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-0be41abd945430b4d"
                      ]
                    }
                  }
                },
                {
                  "Sid": "AttachCodeBuildInterface",
                  "Effect": "Allow",
                  "Action": "ec2:CreateNetworkInterfacePermission",
                  "Resource": "arn:aws:ec2:us-east-1:784514617543:network-interface/*",
                  "Condition": {
                    "StringEquals": {
                      "ec2:AuthorizedService": "codebuild.amazonaws.com"
                    },
                    "ArnEquals": {
                      "ec2:Subnet": [
                        "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-00ce0618188c68de8",
                        "arn:aws:ec2:us-east-1:784514617543:subnet/subnet-0be41abd945430b4d"
                      ]
                    }
                  }
                },
                {
                  "Sid": "NeverChangeStorageOrKeys",
                  "Effect": "Deny",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion",
                    "s3:BypassGovernanceRetention",
                    "s3:PutObjectRetention",
                    "kms:ScheduleKeyDeletion",
                    "kms:DisableKey"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Project": {
      "Type": "AWS::CodeBuild::Project",
      "DependsOn": [
        "PrivateRoute",
        "PrivateAssociationA",
        "PrivateAssociationB",
        "PublicRoute",
        "Logs"
      ],
      "Properties": {
        "Name": "packproof-m1-20261020-migration",
        "Description": "One-shot synthetic migration acceptance; private test DB only",
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Source": {
          "Type": "NO_SOURCE",
          "BuildSpec": "{\"version\":0.2,\"phases\":{\"install\":{\"runtime-versions\":{\"nodejs\":22},\"on-failure\":\"ABORT\",\"commands\":[\"git init candidate\",\"cd candidate\",\"git remote add origin https://github.com/thepackproof/packproof-v2.git\",\"git fetch --depth=1 origin \\\"$CANDIDATE_SHA\\\" \\\"$BASELINE_SHA\\\"\",\"git checkout --detach \\\"$CANDIDATE_SHA\\\"\",\"test \\\"$(git rev-parse HEAD)\\\" = \\\"$CANDIDATE_SHA\\\"\",\"git worktree add --detach /tmp/packproof-m1-baseline \\\"$BASELINE_SHA\\\"\",\"cd backend\",\"npm ci --no-audit --no-fund\",\"ln -s \\\"$PWD/node_modules\\\" /tmp/packproof-m1-baseline/backend/node_modules\",\"curl --fail --silent --show-error --proto =https --tlsv1.2 -o /tmp/packproof-rds-ca.pem https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem\"]},\"build\":{\"on-failure\":\"ABORT\",\"commands\":[\"node scripts/isolated-m1-runner.mjs\"]}}}"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": false,
          "ImagePullCredentialsType": "CODEBUILD",
          "EnvironmentVariables": [
            {
              "Name": "CANDIDATE_SHA",
              "Value": {
                "Ref": "CandidateCommit"
              },
              "Type": "PLAINTEXT"
            },
            {
              "Name": "BASELINE_SHA",
              "Value": "cb82e6e57d50c51e4c55c3e1525a3adc61ce15d5",
              "Type": "PLAINTEXT"
            },
            {
              "Name": "PACKPROOF_TEST_PURPOSE",
              "Value": "isolated-m1-synthetic",
              "Type": "PLAINTEXT"
            },
            {
              "Name": "PACKPROOF_TEST_DB_HOST",
              "Value": "packproof-m1-20261020-db.c8v2esku2zyt.us-east-1.rds.amazonaws.com",
              "Type": "PLAINTEXT"
            },
            {
              "Name": "ISOLATED_DB_SECRET",
              "Value": "arn:aws:secretsmanager:us-east-1:784514617543:secret:rds!db-2e730349-8986-4ded-a190-20a2e369097b-6Ms46r",
              "Type": "SECRETS_MANAGER"
            }
          ]
        },
        "VpcConfig": {
          "VpcId": "vpc-0c4f12c0ba9393ae3",
          "Subnets": [
            "subnet-00ce0618188c68de8",
            "subnet-0be41abd945430b4d"
          ],
          "SecurityGroupIds": [
            {
              "Ref": "BuildSecurityGroup"
            }
          ]
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "Logs"
            },
            "StreamName": "acceptance"
          }
        },
        "TimeoutInMinutes": 20,
        "QueuedTimeoutInMinutes": 10,
        "ConcurrentBuildLimit": 1
      }
    }
  },
  "Outputs": {
    "ProjectName": {
      "Value": {
        "Ref": "Project"
      }
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BuildRole",
          "Arn"
        ]
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    }
  }
}
