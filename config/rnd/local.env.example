# Local experiments only. Never source production credentials or signing profiles.
PACKPROOF_RESEARCH_BUILD=true
PACKPROOF_RND=true
PACKPROOF_RND_ENABLED=0
PACKPROOF_RND_KILL_SWITCH=1
PACKPROOF_ENV=research
EXPO_PUBLIC_PACKPROOF_RND=true
PACKPROOF_OBJECT_STORAGE=local
PACKPROOF_DISTRIBUTION_AUTHORIZED=false
PACKPROOF_ENVIRONMENT=research
PACKPROOF_RND_OPTIONAL_ANALYSIS_ENABLED=false
PACKPROOF_RND_ALLOW_CUSTOMER_DISPLAY=false
PACKPROOF_API_BASE_URL=http://127.0.0.1:3000
PACKPROOF_WEB_BASE_URL=http://127.0.0.1:5173
EXPO_PUBLIC_PACKPROOF_API_BASE_URL=http://127.0.0.1:3000
VITE_PACKPROOF_API_BASE_URL=http://127.0.0.1:3000
# Create an isolated local DB with your own local-only credentials; never reuse the deployed DB.
# DATABASE_URL=postgres://<local-user>:<local-password>@127.0.0.1:5432/packproof_rnd
# Storage defaults must resolve to private local test artifacts, not a production bucket.

# Four controls per feature. Enabling collection never supplies learning consent.
PACKPROOF_RND_PROOFPRINT_COLLECTION=0
PACKPROOF_RND_PROOFPRINT_PROCESSING=0
PACKPROOF_RND_PROOFPRINT_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFPRINT_CUSTOMER_DISPLAY=0
PACKPROOF_RND_VERIFIEDCAPTURE_COLLECTION=0
PACKPROOF_RND_VERIFIEDCAPTURE_PROCESSING=0
PACKPROOF_RND_VERIFIEDCAPTURE_INTERNAL_DISPLAY=0
PACKPROOF_RND_VERIFIEDCAPTURE_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFSIGHT_COLLECTION=0
PACKPROOF_RND_PROOFSIGHT_PROCESSING=0
PACKPROOF_RND_PROOFSIGHT_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFSIGHT_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFTWIN_COLLECTION=0
PACKPROOF_RND_PROOFTWIN_PROCESSING=0
PACKPROOF_RND_PROOFTWIN_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFTWIN_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFMATCH_COLLECTION=0
PACKPROOF_RND_PROOFMATCH_PROCESSING=0
PACKPROOF_RND_PROOFMATCH_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFMATCH_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFLIVE_COLLECTION=0
PACKPROOF_RND_PROOFLIVE_PROCESSING=0
PACKPROOF_RND_PROOFLIVE_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFLIVE_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFSHIELD_COLLECTION=0
PACKPROOF_RND_PROOFSHIELD_PROCESSING=0
PACKPROOF_RND_PROOFSHIELD_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFSHIELD_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFPILOT_COLLECTION=0
PACKPROOF_RND_PROOFPILOT_PROCESSING=0
PACKPROOF_RND_PROOFPILOT_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFPILOT_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFWITNESS_COLLECTION=0
PACKPROOF_RND_PROOFWITNESS_PROCESSING=0
PACKPROOF_RND_PROOFWITNESS_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFWITNESS_CUSTOMER_DISPLAY=0
PACKPROOF_RND_PROOFCOLLECTIVE_COLLECTION=0
PACKPROOF_RND_PROOFCOLLECTIVE_PROCESSING=0
PACKPROOF_RND_PROOFCOLLECTIVE_INTERNAL_DISPLAY=0
PACKPROOF_RND_PROOFCOLLECTIVE_CUSTOMER_DISPLAY=0

# Optional platform trust. Paths must point to private, isolated research policy/credentials.
# PACKPROOF_RND_PLATFORM_POLICY_FILE=/absolute/private/platform-policy.json
# PACKPROOF_RND_GOOGLE_ACCESS_TOKEN_FILE=/absolute/private/google-access-token.txt

# Required by the committed research runtime marker.
PACKPROOF_AUTH_MODE=dev
PACKPROOF_DEV_AUTH=true
PACKPROOF_CREDENTIAL_STORE=memory
PGLITE_DIR=/private/packproof-rnd/research-db
