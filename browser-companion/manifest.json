{
  "manifest_version": 3,
  "name": "PackProof Companion \u2014 Internal Test",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Send a selected supported order to your approved recording phone.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://www.ebay.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Record packing"
  },
  "externally_connectable": {
    "matches": [
      "https://thepackproof.com/*",
      "https://www.thepackproof.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://thepackproof.com/*"
  ]
}
