{
  "name": "@packproof/connect-windows",
  "version": "0.1.0",
  "private": true,
  "description": "PackProof authorized shipment export connection",
  "author": "PackProof",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test tests/release-policy.test.cjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "publish:native": "pwsh -NoProfile -NonInteractive -File scripts/publish-native.ps1",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "verify:artifacts": "pwsh -NoProfile -NonInteractive -File scripts/verify-artifacts.ps1"
  },
  "dependencies": {"electron-updater":"6.8.9","react":"19.1.1","react-dom":"19.1.1","zod":"4.6.7"},
  "devDependencies": {"@types/node":"^24.0.0","@types/react":"^19.1.12","@types/react-dom":"^19.1.9","@vitejs/plugin-react":"^5.0.2","electron":"44.9.3","electron-builder":"26.15.3","esbuild":"^0.25.0","typescript":"^5.9.2","vite":"7.3.7","vitest":"4.1.12","@testing-library/react":"^16.3.0","@testing-library/jest-dom":"^6.8.0","@testing-library/user-event":"^14.6.1","jsdom":"^26.1.0"},
  "overrides": {"undici@^6.0.0":"6.29.1","undici@^7.0.0":"7.30.1","glob@>=9.0.0 <14.0.2":"14.0.3","minimatch@>=7.0.0 <11.0.1":"11.0.1"}
}
