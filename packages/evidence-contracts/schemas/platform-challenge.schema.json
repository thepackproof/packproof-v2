{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thepackproof.com/rnd/v1/platform-challenge.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "challengeId",
    "intentId",
    "proofId",
    "actorId",
    "tenantId",
    "subject",
    "purpose",
    "inventoryDigest",
    "nonce",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "packproof.platform-challenge.v1"
    },
    "challengeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "proofId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "subject": {
      "$ref": "capture-subject.schema.json"
    },
    "purpose": {
      "enum": [
        "REGISTER_KEY",
        "CLOSE_INVENTORY"
      ]
    },
    "inventoryDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "REGISTER_KEY"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "inventoryDigest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "inventoryDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
