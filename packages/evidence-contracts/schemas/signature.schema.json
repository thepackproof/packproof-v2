{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thepackproof.com/rnd/v1/signature.schema.json",
  "type": "object",
  "required": [
    "algorithm",
    "keyId",
    "signatureBase64",
    "signedAt"
  ],
  "properties": {
    "algorithm": {
      "enum": [
        "ECDSA_SHA_256",
        "RSASSA_PSS_SHA_256"
      ]
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signatureBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2048,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
